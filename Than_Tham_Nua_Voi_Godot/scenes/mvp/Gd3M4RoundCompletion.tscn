[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/presentation/mvp/Gd3M4RoundCompletionController.gd" id="1"]
[ext_resource type="Theme" path="res://themes/AppTheme.tres" id="2"]

[node name="Gd3M4RoundCompletion" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.035, 0.045, 0.07, 1)

[node name="Main" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 10.0
offset_right = -12.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Main"]
layout_mode = 2

[node name="Title" type="Label" parent="Main/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "GĐ3-M4 — Integrated Round Completion · TEST_ONLY / PROTOTYPE"
autowrap_mode = 2

[node name="Back" type="Button" parent="Main/Header"]
layout_mode = 2
text = "Back to DebugHome"

[node name="StatusLabel" type="Label" parent="Main"]
unique_name_in_owner = true
layout_mode = 2
text = "Initializing integrated Round…"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Stage" type="Control" parent="Main"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="CaseHost" type="Control" parent="Main/Stage"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="SettlementPanel" type="PanelContainer" parent="Main/Stage"]
