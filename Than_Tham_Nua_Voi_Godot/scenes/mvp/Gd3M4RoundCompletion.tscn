visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Main/Stage/SettlementPanel"]
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Main/Stage/SettlementPanel/Column"]
layout_mode = 2
