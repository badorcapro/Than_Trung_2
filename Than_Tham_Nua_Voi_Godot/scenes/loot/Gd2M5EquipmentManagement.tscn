[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/presentation/loot/Gd2M5Controller.gd" id="1"]
[ext_resource type="Theme" path="res://themes/AppTheme.tres" id="2"]

[node name="Gd2M5EquipmentManagement" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="RootColumn" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/RootColumn"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "GĐ2-M5 — Loot End + Equipment Management + Gacha Foundation"
horizontal_alignment = 1
autowrap_mode = 2

[node name="PhaseLabel" type="Label" parent="Margin/RootColumn"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
horizontal_alignment = 1
autowrap_mode = 2

[node name="BodyScroll" type="ScrollContainer" parent="Margin/RootColumn"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Margin/RootColumn/BodyScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Overview" type="RichTextLabel" parent="Margin/RootColumn/BodyScroll/Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 190)
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
fit_content = true
scroll_active = false

[node name="ResultLabel" type="Label" parent="Margin/RootColumn/BodyScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Confirm all players, then exercise management actions."
autowrap_mode = 2

[node name="ConfirmButton" type="Button" parent="Margin/RootColumn/BodyScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Confirm Loot End (Current Player)"

[node name="ManagementActions" type="GridContainer" parent="Margin/RootColumn/BodyScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 3

[node name="GrantLoadout" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Grant / Test Set"

[node name="Gold" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Nâng 1 Cấp"

[node name="GoldMax" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Nâng Tối Đa"

[node name="Purple" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Purple Promote"

[node name="Basic" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Basic Roll"

[node name="RateUp" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Rate Up (TEST)"

[node name="Perfect" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Perfect Spin"

[node name="SSShop" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "SS Shop (TEST)"

[node name="Done" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ManagementActions"]
layout_mode = 2
size_flags_horizontal = 3
text = "Management Done"

[node name="ChoiceRow" type="GridContainer" parent="Margin/RootColumn/BodyScroll/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 4

[node name="ChoiceLabel" type="Label" parent="Margin/RootColumn/BodyScroll/Body/ChoiceRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "SS chest: choose each hit"
autowrap_mode = 2

[node name="A" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ChoiceRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Choose A"

[node name="B" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ChoiceRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Choose B"

[node name="C" type="Button" parent="Margin/RootColumn/BodyScroll/Body/ChoiceRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Choose C"

[node name="FooterSeparator" type="HSeparator" parent="Margin/RootColumn"]
layout_mode = 2

[node name="Back" type="Button" parent="Margin/RootColumn"]
layout_mode = 2
size_flags_horizontal = 3
text = "Back to DebugHome"

[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ConfirmButton" to="." method="_on_confirm_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/GrantLoadout" to="." method="_on_grant_loadout_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/Gold" to="." method="_on_gold_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/GoldMax" to="." method="_on_gold_max_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/Purple" to="." method="_on_purple_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/Basic" to="." method="_on_basic_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/RateUp" to="." method="_on_rate_up_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/Perfect" to="." method="_on_perfect_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/SSShop" to="." method="_on_ss_shop_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ManagementActions/Done" to="." method="_on_done_pressed"]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ChoiceRow/A" to="." method="_on_choice_pressed" binds=[&"A"]]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ChoiceRow/B" to="." method="_on_choice_pressed" binds=[&"B"]]
[connection signal="pressed" from="Margin/RootColumn/BodyScroll/Body/ChoiceRow/C" to="." method="_on_choice_pressed" binds=[&"C"]]
[connection signal="pressed" from="Margin/RootColumn/Back" to="." method="_on_back_pressed"]
