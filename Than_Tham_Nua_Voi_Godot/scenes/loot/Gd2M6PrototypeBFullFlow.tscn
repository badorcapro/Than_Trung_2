[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/presentation/loot/Gd2M6Controller.gd" id="1"]
[ext_resource type="Theme" path="res://themes/AppTheme.tres" id="2"]

[node name="Gd2M6PrototypeBFullFlow" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.045, 0.07, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "GĐ2-M6 — Prototype B Summary"
horizontal_alignment = 1
autowrap_mode = 2

[node name="StatusLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Status"
horizontal_alignment = 1
autowrap_mode = 2

[node name="Body" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="SummaryText" type="RichTextLabel" parent="Margin/Column/Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 360)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
fit_content = true
autowrap_mode = 2

[node name="Actions" type="GridContainer" parent="Margin/Column"]
layout_mode = 2
columns = 5

[node name="One" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "1 Player"
[node name="Three" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "3 Players"
[node name="Four" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "4 Players"
[node name="Advance" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "Fast Flow → Ready"
[node name="Summary" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "Build Summary"
[node name="Validate" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "Validate Summary"
[node name="Export" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "Export JSON"
[node name="ValidateExport" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "Validate Export"
[node name="Finish" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "Finish Prototype"

[node name="ExportStatus" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Export status"
autowrap_mode = 2

[node name="Back" type="Button" parent="Margin/Column"]
layout_mode = 2
text = "Back to DebugHome"

[connection signal="pressed" from="Margin/Column/Actions/One" to="." method="_on_one_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/Three" to="." method="_on_three_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/Four" to="." method="_on_four_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/Advance" to="." method="_on_advance_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/Summary" to="." method="_on_summary_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/Validate" to="." method="_on_validate_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/Export" to="." method="_on_export_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/ValidateExport" to="." method="_on_validate_export_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/Finish" to="." method="_on_finish_pressed"]
[connection signal="pressed" from="Margin/Column/Back" to="." method="_on_back_pressed"]
