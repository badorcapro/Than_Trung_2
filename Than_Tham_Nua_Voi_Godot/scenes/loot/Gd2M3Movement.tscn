[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/presentation/loot/Gd2M3Controller.gd" id="1"]
[ext_resource type="Theme" path="res://themes/AppTheme.tres" id="2"]

[node name="Gd2M3Movement" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.035, 0.045, 0.07, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 36
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 36
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
text = "GĐ2-M3 — Spawn + Movement Foundation"
theme_override_font_sizes/font_size = 27
horizontal_alignment = 1

[node name="Boundary" type="Label" parent="Margin/Column"]
layout_mode = 2
text = "TEST_ONLY / PROTOTYPE / NOT_CANON_LOCKED — traces only; no reward/item/equipment/gacha runtime"
horizontal_alignment = 1

[node name="PhaseLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
text = "Phase: loading"

[node name="CurrentPlayerLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22

[node name="Body" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="PlayerOverview" type="RichTextLabel" parent="Margin/Column/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true

[node name="MapOverview" type="RichTextLabel" parent="Margin/Column/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true

[node name="ResultLabel" type="RichTextLabel" parent="Margin/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 100)
layout_mode = 2
text = "No movement action yet."

[node name="ValidationLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="Actions" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
alignment = 1

[node name="MoveButton" type="Button" parent="Margin/Column/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Roll / Move"

[node name="BackButton" type="Button" parent="Margin/Column/Actions"]
layout_mode = 2
text = "Back to DebugHome"

[connection signal="pressed" from="Margin/Column/Actions/MoveButton" to="." method="_on_move_pressed"]
[connection signal="pressed" from="Margin/Column/Actions/BackButton" to="." method="_on_back_pressed"]
