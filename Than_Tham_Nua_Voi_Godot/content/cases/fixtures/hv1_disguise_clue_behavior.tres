[gd_resource type="Resource" script_class="CaseDefinition" load_steps=17 format=3]

[ext_resource type="Script" path="res://scripts/domain/cases/CaseDefinition.gd" id="1_case"]
[ext_resource type="Script" path="res://scripts/domain/cases/SuspectDefinition.gd" id="2_suspect"]
[ext_resource type="Script" path="res://scripts/domain/cases/OnSolveReward.gd" id="3_reward"]
[ext_resource type="Script" path="res://scripts/domain/cases/CrimeSceneDefinition.gd" id="4_crime_scene"]
[ext_resource type="Script" path="res://scripts/domain/cases/ClockTowerDefinition.gd" id="5_clock_tower"]
[ext_resource type="Script" path="res://scripts/domain/cases/BoardLocationDefinition.gd" id="6_board_location"]

[sub_resource type="Resource" id="OnSolve"]
script = ExtResource("3_reward")
reward_id = &"hv1_disguise_clue_behavior_reward"
reputation_delta = 0
test_only_not_balance_locked = true
note = "DEV_ONLY: deterministic human verification fixture; no production reward."

[sub_resource type="Resource" id="CrimeScene"]
script = ExtResource("4_crime_scene")
scene_id = &"hv1_disguise_clue_scene"
display_name = "Hiện trường kiểm chứng"
board_slot = 4
description = "Fixture DEV để kiểm chứng vai thật, vai hiển thị, hành vi và chế độ nói thật/nói dối."

[sub_resource type="Resource" id="ClockTower"]
script = ExtResource("5_clock_tower")
location_id = &"clock_tower"
display_name = "Tháp Đồng Hồ"
board_slot = 8
ring_hour = 8

