[resource]
script = ExtResource("1_case")
case_id = &"hv1_disguise_clue_behavior"
data_version = 1
display_name = "HV1 — Disguise & Clue Behavior"
short_description = "DEV-only authored Case for manually checking true, displayed, behavior, truth-mode, public clue, and Full Reveal separation."
difficulty_label = "DEV HV1"
crime_scene = SubResource("CrimeScene")
board_locations = Array[ExtResource("6_board_location")]([SubResource("ClockTower")])
merit_pool = 0
reputation_penalty_on_wrong = 0
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4"), SubResource("Suspect5"), SubResource("Suspect6"), SubResource("Suspect7")])
evil_suspect_ids = PackedInt32Array(2, 5, 6)
accomplice_suspect_ids = PackedInt32Array(2, 5)
traitor_suspect_ids = PackedInt32Array(6)
suspected_role_ids = Array[StringName]([&"tutorial_priest", &"therapist", &"clock_maker", &"tutorial_mobster", &"copycat", &"critic", &"serial_killer", &"mailman", &"weatherman"])
suspect_list_role_ids = Array[StringName]([&"tutorial_priest", &"therapist", &"clock_maker", &"tutorial_mobster", &"copycat", &"critic", &"serial_killer", &"mailman", &"weatherman"])
test_only_not_balance_locked = true
balance_note = "DEV_ONLY / NOT_BALANCE_LOCKED: HV1 disguise and clue behavior verification fixture."
