role_group = 2
truth_reveal_note = "Kẻ Bất Lương cùng Phe Ác với #4 để kiểm tra kết quả Thợ May bị đảo."

[resource]
script = ExtResource("1_case")
case_id = &"hv3_timed_coexistence"
data_version = 1
display_name = "HV3 — Timed Coexistence"
short_description = "DEV-only authored Case for checking Serial Killer timed events remain independent from a borrowed Tailor function."
difficulty_label = "DEV HV3"
crime_scene = SubResource("CrimeScene")
merit_pool = 0
reputation_penalty_on_wrong = 0
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4"), SubResource("Suspect5")])
evil_suspect_ids = PackedInt32Array(4, 5)
accomplice_suspect_ids = PackedInt32Array(4, 5)
traitor_suspect_ids = PackedInt32Array()
suspected_role_ids = Array[StringName]([&"tailor", &"reporter", &"tutorial_priest", &"serial_killer", &"tutorial_scoundrel"])
suspect_list_role_ids = Array[StringName]([&"tailor", &"reporter", &"tutorial_priest", &"serial_killer", &"tutorial_scoundrel"])
requires_tailor = true
test_only_not_balance_locked = true
balance_note = "DEV_ONLY: HV3 Serial Killer active-first timed-coexistence fixture, not tutorial or production content."
