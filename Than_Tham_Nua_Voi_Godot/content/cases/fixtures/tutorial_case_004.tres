[gd_resource type="Resource" script_class="CaseDefinition" load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/domain/cases/CaseDefinition.gd" id="1_case"]
[ext_resource type="Script" path="res://scripts/domain/cases/SuspectDefinition.gd" id="2_suspect"]
[ext_resource type="Script" path="res://scripts/domain/cases/OnSolveReward.gd" id="3_reward"]
[ext_resource type="Script" path="res://scripts/domain/cases/CrimeSceneDefinition.gd" id="4_crime_scene"]

[sub_resource type="Resource" id="OnSolve"]
script = ExtResource("3_reward")
reward_id = &"tutorial_case_004_reward"
reputation_delta = 1
test_only_not_balance_locked = true
note = "TEST_ONLY / NOT_BALANCE_LOCKED: tutorial active-function fixture only."

[sub_resource type="Resource" id="CrimeScene"]
script = ExtResource("4_crime_scene")
scene_id = &"tutorial_scene_004"
display_name = "Hiện trường tháp chuông"
board_slot = 4
description = "Một hiện trường hướng dẫn trung tính cho bài học về chức năng chủ động và giả vai."

[sub_resource type="Resource" id="Suspect1"]
script = ExtResource("2_suspect")
suspect_id = 1
board_slot = 0
true_role_id = &"tailor"
displayed_role_id = &"tailor"
true_alignment = 0
role_group = 0
truth_reveal_note = "Thợ May thật cho kết quả so phe đúng."

[sub_resource type="Resource" id="Suspect2"]
script = ExtResource("2_suspect")
suspect_id = 2
board_slot = 2
true_role_id = &"tutorial_mobster"
displayed_role_id = &"tailor"
true_alignment = 1
role_group = 2
is_impersonating = true
impersonated_role_id = &"tailor"
truth_reveal_note = "Kẻ Côn Đồ nói dối khi giả làm Thợ May."

[sub_resource type="Resource" id="Suspect3"]
script = ExtResource("2_suspect")
suspect_id = 3
board_slot = 6
true_role_id = &"mailman"
displayed_role_id = &"mailman"
true_alignment = 0
role_group = 0
mailman_claimed_in_play_role_id = &"tailor"
mailman_claimed_not_in_play_role_id = &"mathematician"
truth_reveal_note = "Dịch Phu nói đúng rằng Thợ May đang có và Nhà Toán Học không có trong Kỳ Án."

[sub_resource type="Resource" id="Suspect4"]
script = ExtResource("2_suspect")
suspect_id = 4
board_slot = 8
true_role_id = &"tutorial_priest"
displayed_role_id = &"tutorial_priest"
true_alignment = 0
role_group = 0
public_investigation_statement = "Tôi là Tư Tế."
truth_reveal_note = "Tư Tế tự xác nhận đúng."

[resource]
script = ExtResource("1_case")
case_id = &"tutorial_case_004"
data_version = 1
display_name = "Hướng Dẫn 04: Chức Năng Chủ Động"
short_description = "Tutorial về chức năng một lần, vai hiển thị trùng nhau do giả vai, và kết quả mâu thuẫn để nhận diện Kẻ Côn Đồ."
difficulty_label = "TUTORIAL"
crime_scene = SubResource("CrimeScene")
merit_pool = 6
reputation_penalty_on_wrong = 1
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4")])
evil_suspect_ids = PackedInt32Array(2)
accomplice_suspect_ids = PackedInt32Array(2)
traitor_suspect_ids = PackedInt32Array()
requires_tailor = true
test_only_not_balance_locked = true
balance_note = "TEST_ONLY / NOT_BALANCE_LOCKED: tutorial active-function and true-role uniqueness fixture only."
