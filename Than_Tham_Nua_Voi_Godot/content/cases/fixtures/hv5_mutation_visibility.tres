[gd_resource type="Resource" script_class="CaseDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/domain/cases/CaseDefinition.gd" id="1_case"]
[ext_resource type="Script" path="res://scripts/domain/cases/SuspectDefinition.gd" id="2_suspect"]
[ext_resource type="Script" path="res://scripts/domain/cases/OnSolveReward.gd" id="3_reward"]
[ext_resource type="Script" path="res://scripts/domain/cases/CrimeSceneDefinition.gd" id="4_crime_scene"]

[sub_resource type="Resource" id="OnSolve"]
script = ExtResource("3_reward")
reward_id = &"hv5_mutation_visibility_reward"
reputation_delta = 0
test_only_not_balance_locked = true
note = "DEV_ONLY: HV5 mutation and visibility verification has no production reward."

[sub_resource type="Resource" id="CrimeScene"]
script = ExtResource("4_crime_scene")
scene_id = &"hv5_mutation_visibility_scene"
display_name = "Hiện trường kiểm chứng"
board_slot = 4
description = "DEV-only neutral location for taint, transform, and obscure verification."

[sub_resource type="Resource" id="Suspect1"]
script = ExtResource("2_suspect")
suspect_id = 1
board_slot = 0
true_role_id = &"poisoner"
displayed_role_id = &"reporter"
true_alignment = 1
role_group = 2
is_impersonating = true
impersonated_role_id = &"reporter"
truth_reveal_note = "Độc Sư giả danh Sử Quan và Tha Hóa Tư Tế ở Số Hiệu 2."

[sub_resource type="Resource" id="Suspect2"]
script = ExtResource("2_suspect")
suspect_id = 2
board_slot = 1
true_role_id = &"tutorial_priest"
displayed_role_id = &"tutorial_priest"
true_alignment = 0
role_group = 0
truth_reveal_note = "Tư Tế giữ nguyên thân phận và phe, nhưng bị Độc Sư Tha Hóa."

[sub_resource type="Resource" id="Suspect3"]
script = ExtResource("2_suspect")
suspect_id = 3
board_slot = 2
true_role_id = &"barkeep"
displayed_role_id = &"reporter"
true_alignment = 1
role_group = 2
is_impersonating = true
impersonated_role_id = &"reporter"
truth_reveal_note = "Chủ Quán Rượu giả danh Sử Quan và biến Số Hiệu 5 thành Kẻ Say Rượu."

[sub_resource type="Resource" id="Suspect4"]
script = ExtResource("2_suspect")
suspect_id = 4
board_slot = 3
true_role_id = &"spectre"
displayed_role_id = &"reporter"
true_alignment = 1
role_group = 2
is_impersonating = true
impersonated_role_id = &"reporter"
obscure_target_suspect_id = 6
truth_reveal_note = "Vong Linh giả danh Sử Quan và che thân phận của Ngự Y ở Số Hiệu 6."

[sub_resource type="Resource" id="Suspect5"]
script = ExtResource("2_suspect")
suspect_id = 5
board_slot = 5
true_role_id = &"mailman"
displayed_role_id = &"mailman"
true_alignment = 0
role_group = 0
mailman_claimed_in_play_role_id = &"mathematician"
mailman_claimed_not_in_play_role_id = &"reporter"
truth_reveal_note = "Dịch Phu ban đầu bị biến thành Kẻ Say Rượu; vẫn hiện và hành xử như Dịch Phu nhưng nói dối."

[sub_resource type="Resource" id="Suspect6"]
script = ExtResource("2_suspect")
suspect_id = 6
board_slot = 6
true_role_id = &"therapist"
displayed_role_id = &"therapist"
true_alignment = 0
role_group = 0
truth_reveal_note = "Ngự Y bị Vong Linh che thân phận công khai; thông tin điều tra vẫn được giữ lại."

[sub_resource type="Resource" id="Suspect7"]
script = ExtResource("2_suspect")
suspect_id = 7
board_slot = 7
true_role_id = &"reporter"
displayed_role_id = &"reporter"
true_alignment = 0
role_group = 0
truth_reveal_note = "Sử Quan thật là vai hiện diện cho các vai giả danh Sử Quan."

[resource]
script = ExtResource("1_case")
case_id = &"hv5_mutation_visibility"
data_version = 1
display_name = "HV5 — Mutation & Visibility"
short_description = "DEV-only authored Case for checking Poisoner taint, Barkeep transformation, Spectre obscure, public identity, and Full Reveal truth."
difficulty_label = "DEV HV5"
crime_scene = SubResource("CrimeScene")
merit_pool = 0
reputation_penalty_on_wrong = 0
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4"), SubResource("Suspect5"), SubResource("Suspect6"), SubResource("Suspect7")])
evil_suspect_ids = PackedInt32Array(1, 3, 4)
accomplice_suspect_ids = PackedInt32Array(1, 3, 4)
traitor_suspect_ids = PackedInt32Array()
suspected_role_ids = Array[StringName]([&"reporter", &"therapist", &"tutorial_priest", &"mailman", &"mathematician", &"poisoner", &"barkeep", &"spectre"])
suspect_list_role_ids = Array[StringName]([&"reporter", &"therapist", &"tutorial_priest", &"mailman", &"mathematician", &"poisoner", &"barkeep", &"spectre"])
nested_suspect_list_role_ids_by_parent = {&"barkeep": Array[StringName]([&"drunkard"])}
startup_poisoner_source_suspect_id = 1
startup_poisoner_target_suspect_id = 2
startup_barkeep_source_suspect_id = 3
startup_barkeep_target_suspect_id = 5
test_only_not_balance_locked = true
balance_note = "DEV_ONLY / NOT_BALANCE_LOCKED: HV5 mutation and visibility human verification fixture."
