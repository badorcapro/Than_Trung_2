[resource]
script = ExtResource("1_case")
case_id = &"hv2_active_disguise"
data_version = 1
display_name = "HV2 — Active Disguise"
short_description = "DEV-only authored Case for manually checking borrowed Tailor/Vigilante functions, truth modes, and independent one-use state."
difficulty_label = "DEV HV2"
crime_scene = SubResource("CrimeScene")
merit_pool = 0
reputation_penalty_on_wrong = 0
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4"), SubResource("Suspect5"), SubResource("Suspect6"), SubResource("Suspect7")])
evil_suspect_ids = PackedInt32Array(6, 7)
accomplice_suspect_ids = PackedInt32Array(6, 7)
traitor_suspect_ids = PackedInt32Array()
suspected_role_ids = Array[StringName]([&"tailor", &"vigilante", &"copycat", &"tutorial_priest", &"reporter", &"tutorial_mobster", &"serial_killer"])
suspect_list_role_ids = Array[StringName]([&"tailor", &"vigilante", &"copycat", &"tutorial_priest", &"reporter", &"tutorial_mobster", &"serial_killer"])
requires_tailor = true
test_only_not_balance_locked = true
balance_note = "DEV_ONLY: HV2 active-disguise runtime verification fixture, not tutorial or production content."
