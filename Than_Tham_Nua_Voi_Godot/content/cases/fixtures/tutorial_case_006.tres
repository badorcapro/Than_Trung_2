[resource]
script = ExtResource("1_case")
case_id = &"tutorial_case_006"
data_version = 1
display_name = "Hướng Dẫn 06: Tha Hóa và Biến Đổi"
short_description = "Tutorial về Độc Sư, Chủ Quán Rượu, Kẻ Say Rượu, Ngự Khuyển Quan, và Dịch Phu đọc vai hiện tại sau biến đổi."
difficulty_label = "TUTORIAL"
crime_scene = SubResource("CrimeScene")
merit_pool = 9
reputation_penalty_on_wrong = 1
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4"), SubResource("Suspect5"), SubResource("Suspect6"), SubResource("Suspect7")])
evil_suspect_ids = PackedInt32Array(1, 3)
accomplice_suspect_ids = PackedInt32Array(1, 3)
traitor_suspect_ids = PackedInt32Array()
suspected_role_ids = Array[StringName]([&"reporter", &"therapist", &"blood_hound", &"tutorial_priest", &"mailman", &"mathematician", &"barkeep", &"poisoner"])
suspect_list_role_ids = Array[StringName]([&"reporter", &"therapist", &"blood_hound", &"tutorial_priest", &"mailman", &"mathematician", &"barkeep", &"poisoner"])
nested_suspect_list_role_ids_by_parent = {&"barkeep": Array[StringName]([&"drunkard"])}
startup_poisoner_source_suspect_id = 1
startup_poisoner_target_suspect_id = 2
startup_barkeep_source_suspect_id = 3
startup_barkeep_target_suspect_id = 6
test_only_not_balance_locked = true
balance_note = "TEST_ONLY / NOT_BALANCE_LOCKED: Tutorial 06 integration fixture for Poisoner taint, Barkeep transformation, Blood Hound, Drunkard, and Mailman current-role truth."
