[gd_resource type="Resource" script_class="CaseDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/domain/cases/CaseDefinition.gd" id="1_case"]
[ext_resource type="Script" path="res://scripts/domain/cases/SuspectDefinition.gd" id="2_suspect"]
[ext_resource type="Script" path="res://scripts/domain/cases/OnSolveReward.gd" id="3_reward"]
[ext_resource type="Script" path="res://scripts/domain/cases/CrimeSceneDefinition.gd" id="4_crime_scene"]

[sub_resource type="Resource" id="OnSolve"]
script = ExtResource("3_reward")
reward_id = &"tutorial_case_005_reward"
reputation_delta = 1
test_only_not_balance_locked = true
note = "TEST_ONLY / NOT_BALANCE_LOCKED: tutorial timed-role fixture only."

[sub_resource type="Resource" id="CrimeScene"]
script = ExtResource("4_crime_scene")
scene_id = &"tutorial_scene_005"
display_name = "Hiện trường tháp đồng hồ"
board_slot = 3
description = "Một hiện trường hướng dẫn cho vai trò thời gian và Nghịch Thần."

[sub_resource type="Resource" id="Suspect1"]
script = ExtResource("2_suspect")
suspect_id = 1
board_slot = 0
true_role_id = &"critic"
displayed_role_id = &"mathematician"
true_alignment = 1
role_group = 3
is_impersonating = true
impersonated_role_id = &"mathematician"
truth_reveal_note = "Nhà Phê Bình nói dối khi giả danh Nhà Toán Học."

[sub_resource type="Resource" id="Suspect2"]
script = ExtResource("2_suspect")
suspect_id = 2
board_slot = 2
true_role_id = &"tutorial_priest"
displayed_role_id = &"tutorial_priest"
true_alignment = 0
role_group = 0
public_investigation_statement = "Tôi là Tư Tế."
truth_reveal_note = "Tư Tế tự xác nhận đúng."

[sub_resource type="Resource" id="Suspect3"]
script = ExtResource("2_suspect")
suspect_id = 3
board_slot = 4
true_role_id = &"weatherman"
displayed_role_id = &"weatherman"
true_alignment = 0
role_group = 0
truth_reveal_note = "Nhà Khí Tượng chỉ ra một Người Vô Tội, một Kẻ Bao Đồng, và một Phe Ác."

[sub_resource type="Resource" id="Suspect4"]
script = ExtResource("2_suspect")
suspect_id = 4
board_slot = 6
true_role_id = &"tutorial_mobster"
displayed_role_id = &"tutorial_priest"
true_alignment = 1
role_group = 2
is_impersonating = true
impersonated_role_id = &"tutorial_priest"
truth_reveal_note = "Kẻ Côn Đồ nói dối khi giả danh Tư Tế."

[sub_resource type="Resource" id="Suspect5"]
script = ExtResource("2_suspect")
suspect_id = 5
board_slot = 7
true_role_id = &"vigilante"
displayed_role_id = &"vigilante"
true_alignment = 0
role_group = 0
truth_reveal_note = "Dân Phòng bắt đầu còn sống và có chức năng một mục tiêu."

[sub_resource type="Resource" id="Suspect6"]
script = ExtResource("2_suspect")
suspect_id = 6
board_slot = 8
true_role_id = &"surgeon"
displayed_role_id = &"surgeon"
true_alignment = 0
role_group = 1
truth_reveal_note = "Bác Sĩ Phẫu Thuật là Kẻ Bao Đồng được service timed-event phát hiện."

[resource]
script = ExtResource("1_case")
case_id = &"tutorial_case_005"
data_version = 1
display_name = "Hướng Dẫn 05: Thời Gian và Nghịch Thần"
short_description = "Tutorial về vai trò thời gian, vai giả danh không thật sự có trong Kỳ Án, và Phe Ác gồm Thuộc Hạ + Nghịch Thần."
difficulty_label = "TUTORIAL"
crime_scene = SubResource("CrimeScene")
merit_pool = 8
reputation_penalty_on_wrong = 1
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4"), SubResource("Suspect5"), SubResource("Suspect6")])
suspected_role_ids = Array[StringName]([&"mathematician", &"weatherman", &"vigilante", &"tutorial_priest", &"surgeon", &"tutorial_mobster", &"critic"])
suspect_list_role_ids = Array[StringName]([&"mathematician", &"weatherman", &"vigilante", &"tutorial_priest", &"surgeon", &"tutorial_mobster", &"critic"])
evil_suspect_ids = PackedInt32Array(1, 4)
accomplice_suspect_ids = PackedInt32Array(4)
traitor_suspect_ids = PackedInt32Array(1)
test_only_not_balance_locked = true
balance_note = "TEST_ONLY / NOT_BALANCE_LOCKED: Tutorial 05 integration fixture for Critic, Vigilante, Surgeon, and role-information foundations."
