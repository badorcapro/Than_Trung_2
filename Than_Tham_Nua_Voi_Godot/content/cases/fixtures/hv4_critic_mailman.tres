[resource]
script = ExtResource("1_case")
case_id = &"hv4_critic_mailman"
data_version = 1
display_name = "HV4 — Critic & Mailman"
short_description = "DEV-only authored Case for checking listed-but-current-absent Critic disguise and Mailman current-role presence."
difficulty_label = "DEV HV4"
crime_scene = SubResource("CrimeScene")
merit_pool = 0
reputation_penalty_on_wrong = 0
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4"), SubResource("Suspect5")])
evil_suspect_ids = PackedInt32Array(3, 5)
accomplice_suspect_ids = PackedInt32Array(5)
traitor_suspect_ids = PackedInt32Array(3)
suspected_role_ids = Array[StringName]([&"tutorial_priest", &"mailman", &"critic", &"reporter", &"tutorial_scoundrel", &"blood_hound"])
suspect_list_role_ids = Array[StringName]([&"tutorial_priest", &"mailman", &"critic", &"reporter", &"tutorial_scoundrel", &"blood_hound"])
test_only_not_balance_locked = true
balance_note = "DEV_ONLY / NOT_BALANCE_LOCKED: HV4 Critic and Mailman human verification fixture."
