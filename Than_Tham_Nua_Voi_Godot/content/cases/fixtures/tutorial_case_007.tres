[resource]
script = ExtResource("1_case")
case_id = &"tutorial_case_007"
data_version = 1
display_name = "Hướng Dẫn 07: Thời Gian Nguy Hiểm"
short_description = "Tutorial về điều tra làm thời gian trôi, Tháp Đồng Hồ, và vai trò có thể thay đổi trạng thái bàn án theo thời gian."
tutorial_dialogue_lines = PackedStringArray("Thám Tử, hẳn ngươi đã nhận ra rằng mỗi khi điều tra một vai trò, thời gian sẽ trôi qua.", "Điều tra một vai trò mất 2 giờ, còn Chỉ Điểm một vai trò mất 1 giờ.", "Sử dụng chức năng không làm thời gian trôi qua.", "Ngươi có thể xem thời gian hiện tại trên chiếc đồng hồ ở góc trên bên trái.", "Cho đến giờ điều đó chưa quá quan trọng, nhưng ta phải cảnh báo ngươi.", "Ở nhiều nơi, hiểm họa vẫn còn đang rình rập.", "Một số vai trò có thể làm thay đổi trạng thái của Bàn Kỳ Án theo thời gian.", "Đôi khi Chỉ Điểm sớm sẽ tốt hơn là chờ đợi...")
difficulty_label = "TUTORIAL"
crime_scene = SubResource("CrimeScene")
board_locations = Array[ExtResource("6_board_location")]([SubResource("ClockTower")])
merit_pool = 9
reputation_penalty_on_wrong = 1
base_ticket_reward = 0
on_solve = SubResource("OnSolve")
suspects = Array[ExtResource("2_suspect")]([SubResource("Suspect1"), SubResource("Suspect2"), SubResource("Suspect3"), SubResource("Suspect4"), SubResource("Suspect5"), SubResource("Suspect6"), SubResource("Suspect7")])
evil_suspect_ids = PackedInt32Array(4, 7)
accomplice_suspect_ids = PackedInt32Array(4, 7)
traitor_suspect_ids = PackedInt32Array()
suspected_role_ids = Array[StringName]([&"surgeon", &"therapist", &"blood_hound", &"tutorial_mobster", &"clock_maker", &"reporter", &"serial_killer"])
suspect_list_role_ids = Array[StringName]([&"surgeon", &"therapist", &"blood_hound", &"tutorial_mobster", &"clock_maker", &"reporter", &"serial_killer"])
test_only_not_balance_locked = true
balance_note = "TEST_ONLY / NOT_BALANCE_LOCKED: Tutorial 07 integration fixture for Clock Tower, Clock Maker pretends, Surgeon 12h event, and Serial Killer 9h event."
