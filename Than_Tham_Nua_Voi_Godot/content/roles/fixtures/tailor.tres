[resource]
script = ExtResource("1")
role_id = &"tailor"
display_name = "Thợ May"
help_text = "💬 Chức năng: Chọn đúng hai nghi phạm khác nhau. Ta thông báo họ cùng phe hay khác phe dựa trên phe thật của họ.

❗ Ta có thể chọn chính mình cùng một mục tiêu khác. Ta cũng có thể chọn nghi phạm đã chết, chưa được điều tra hoặc đã bị bắt. Chức năng này chỉ dùng được một lần.

❓ Khi ta nói dối hoặc bị tha hóa, ta thông báo kết quả ngược lại với sự thật.

Thông báo:
#X và #Y cùng phe.
#X và #Y không cùng phe."
has_interactive_function = true
