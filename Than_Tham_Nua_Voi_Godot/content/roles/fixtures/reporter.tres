[resource]
script = ExtResource("1")
role_id = &"reporter"
display_name = "Sử Quan"
help_text = "💬 Khi được điều tra, ta thông báo số bước ngắn nhất để đến nghi phạm có thân phận thật thuộc Phe Ác gần nhất. Ta chỉ đi theo bốn hướng Bắc, Đông, Nam và Tây; ô ta đang đứng không tính là một bước. Đường đi có thể qua ô nghi phạm, địa điểm hoặc ô trống.

❓Khi ta nói dối hoặc bị tha hóa, ta thông báo một số bước từ 1 đến 4 và số đó khác kết quả thật."
is_fixture_placeholder = false
