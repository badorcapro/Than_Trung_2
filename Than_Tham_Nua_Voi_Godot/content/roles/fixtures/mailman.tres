script = ExtResource("1")
role_id = &"mailman"
display_name = "Dịch Phu"
help_text = "💬 Khi được điều tra, ta nêu một thân phận xuất hiện trong Kỳ Án và một thân phận không xuất hiện trong Kỳ Án, đồng thời phân biệt rõ hai trường hợp.

❗Ta xét thân phận thật hiện tại, không bị đánh lừa bởi giả danh và không nhắc đến chính mình.

❓Khi ta nói dối hoặc bị tha hóa, cả hai nhận định của ta đều sai."
