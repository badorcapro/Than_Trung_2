script = ExtResource("1")
role_id = &"tutorial_priest"
display_name = "Tư Tế"
help_text = "💬 Khi được điều tra và nói thật, ta thông báo: \"Tôi là Tư Tế.\"

❗ Ta là một thân phận tự xác thực.

❓ Khi nói dối hoặc bị tha hóa, ta thông báo một trong các câu sau:
- \"Ta có thật là một Tư Tế tốt không?\"
- \"Tôi chỉ nhớ mình từng đứng trong thánh đường.\""
is_fixture_placeholder = false
