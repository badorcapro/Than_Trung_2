[resource]
script = ExtResource("1")
role_id = &"tutorial_scoundrel"
display_name = "Kẻ Bất Lương"
role_group = 2
help_text = "💬 Khi được điều tra, ta chỉ để lộ tên thân phận và không thông báo gì.

❗ Ta không thể bị bắt hoặc bị giết, trừ khi ta là thân phận Phe Ác thật sự duy nhất còn sống và chưa bị bắt. Những thân phận Phe Thiện chỉ trông giống Phe Ác không được tính vào điều kiện này.

❗ Một lần Chỉ Điểm thất bại vào ta vẫn làm thời gian trôi qua. Việc giết một thân phận Phe Ác không thay cho Chỉ Điểm hoặc Phán Quyết Cuối.

❓ Khi bị tha hóa, ta có thể bị bắt hoặc bị giết dù chưa phải là thân phận Phe Ác cuối cùng."
is_fixture_placeholder = false
